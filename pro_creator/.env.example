# Storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pro-creator
S3_REGION=us-east-1

# Auth
AUTH_REQUIRED=false
ENVIRONMENT=development
STRICT_PROVIDER_VALIDATION=false
JWT_SECRET=change-me
ADMIN_EMAIL=admin@procreator.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DASHBOARD_PASSWORD=ChangeMe123!
ADMIN_2FA_ENABLED=false
ADMIN_2FA_TOTP_SECRET=
OWNER_EMAIL_ALLOWLIST=
DEFAULT_TENANT_ID=default
TENANT_HEADER_NAME=X-Tenant-ID
FACTORY_MODE_ENABLED=false
DATABASE_URL=sqlite:///backend/pro_creator.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_PROJECTS_BASE=http://localhost:8000/projects
NEXT_PUBLIC_FACTORY_MODE_ENABLED=false

# TTS
TTS_PROVIDER=xtts
XTTS_ENDPOINT=http://localhost:8020/api/tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Script LLM (optional, enables high-quality humanized script writing)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_DRAFT=gpt-4o-mini
OPENAI_MODEL_STANDARD=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
SCRIPT_PROVIDER=auto
IMAGE_PROVIDER=openai
VOICE_PROVIDER_DEFAULT=xtts
RUNWAY_VIDEO_ENABLED=false
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_VIDEO_MODEL_DEFAULT=gen4_turbo
RUNWAY_VIDEO_MODEL_PREMIUM=gen4.5
RUNWAY_HERO_SCENES=first,last
RUNWAY_VIDEO_DURATION_SECONDS=5
RUNWAY_POLL_TIMEOUT_SECONDS=240
RUNWAY_POLL_INTERVAL_SECONDS=4

# Credit costs per action
CREDITS_COST_SCRIPT_GENERATE=6
CREDITS_COST_SCRIPT_IMPORT=2
CREDITS_COST_VOICE_GENERATE=8
CREDITS_COST_IMAGE_GENERATE=7
CREDITS_COST_VIDEO_RENDER=20
CREDITS_COST_VIDEO_EXPORT=4
CREDITS_COST_THUMBNAIL_GENERATE=3
CREDITS_COST_THUMBNAIL_AI_GENERATE=6

# Stripe checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MODERATE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_STUDIO=
STRIPE_SUCCESS_URL=http://localhost:3000/?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/?checkout=cancel

# Paystack checkout
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/?checkout=success&provider=paystack
PAYSTACK_CURRENCY=GHS

# Email receipts / notifications
EMAIL_FROM_NAME=Pro Creator
EMAIL_FROM_ADDRESS=admin@procreator.local
EMAIL_REPLY_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

# Lip sync (optional Rhubarb)
AUTO_LIPSYNC=true
RHUBARB_PATH=
RHUBARB_TIMEOUT=30

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH_REQUESTS=15
RATE_LIMIT_HEAVY_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
