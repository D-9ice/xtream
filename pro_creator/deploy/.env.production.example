# Domain/TLS
DOMAIN_NAME=app.example.com
LETSENCRYPT_EMAIL=ops@example.com
NEXT_PUBLIC_API_BASE=https://api.example.com
NEXT_PUBLIC_PROJECTS_BASE=https://cdn.example.com/projects

# Optional AWS Secrets Manager settings
AWS_SECRETS_ENABLED=false
AWS_SECRETS_REGION=us-east-1
AWS_SECRET_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Auth
ENVIRONMENT=production
STRICT_PROVIDER_VALIDATION=true
AUTH_REQUIRED=true
JWT_SECRET=change-me
# Optional file-based secret sources (preferred)
# JWT_SECRET_FILE=./deploy/secrets/jwt_secret
# Optional AWS secret id/key mapping
# JWT_SECRET_AWS_SECRET_ID=pro-creator/prod/jwt
# JWT_SECRET_AWS_SECRET_KEY=jwt_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DASHBOARD_PASSWORD=ChangeMe123!
ADMIN_2FA_ENABLED=false
ADMIN_2FA_TOTP_SECRET=
OWNER_EMAIL_ALLOWLIST=admin@example.com,owner@example.com
DEFAULT_TENANT_ID=default
TENANT_HEADER_NAME=X-Tenant-ID
FACTORY_MODE_ENABLED=false
NEXT_PUBLIC_FACTORY_MODE_ENABLED=false
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# ADMIN_2FA_TOTP_SECRET_FILE=./deploy/secrets/admin_2fa_totp_secret
# ADMIN_2FA_TOTP_SECRET_AWS_SECRET_ID=pro-creator/prod/admin-2fa
# ADMIN_2FA_TOTP_SECRET_AWS_SECRET_KEY=totp_secret
# ADMIN_PASSWORD_FILE=./deploy/secrets/admin_password
# ADMIN_PASSWORD_AWS_SECRET_ID=pro-creator/prod/admin
# ADMIN_PASSWORD_AWS_SECRET_KEY=admin_password
# ADMIN_DASHBOARD_PASSWORD_FILE=./deploy/secrets/admin_dashboard_password
# ADMIN_DASHBOARD_PASSWORD_AWS_SECRET_ID=pro-creator/prod/admin-dashboard
# ADMIN_DASHBOARD_PASSWORD_AWS_SECRET_KEY=admin_dashboard_password

# Database (Postgres)
POSTGRES_DB=procreator
POSTGRES_USER=procreator
POSTGRES_PASSWORD=change-me-db-password
# POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
DATABASE_URL=postgresql+psycopg://procreator:change-me-db-password@postgres:5432/procreator
# DATABASE_URL_FILE=./deploy/secrets/database_url
# DATABASE_URL_AWS_SECRET_ID=pro-creator/prod/database
# DATABASE_URL_AWS_SECRET_KEY=database_url

# DigitalOcean Spaces (S3 compatible)
S3_BUCKET=pro-creator
S3_REGION=nyc3
S3_ACCESS_KEY=do-access-key
# S3_ACCESS_KEY_FILE=./deploy/secrets/s3_access_key
# S3_ACCESS_KEY_AWS_SECRET_ID=pro-creator/prod/s3
# S3_ACCESS_KEY_AWS_SECRET_KEY=access_key
S3_SECRET_KEY=do-secret-key
# S3_SECRET_KEY_FILE=./deploy/secrets/s3_secret_key
# S3_SECRET_KEY_AWS_SECRET_ID=pro-creator/prod/s3
# S3_SECRET_KEY_AWS_SECRET_KEY=secret_key
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_PUBLIC_URL=https://pro-creator.nyc3.digitaloceanspaces.com

# TTS
TTS_PROVIDER=xtts
XTTS_ENDPOINT=http://xtts:8020/api/tts
XTTS_IMAGE=ghcr.io/coqui-ai/xtts:latest
ELEVENLABS_API_KEY=
# ELEVENLABS_API_KEY_FILE=./deploy/secrets/elevenlabs_api_key
# ELEVENLABS_API_KEY_AWS_SECRET_ID=pro-creator/prod/elevenlabs
# ELEVENLABS_API_KEY_AWS_SECRET_KEY=api_key
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Script LLM (optional, enables natural/humanized scripts)
SCRIPT_PROVIDER=auto
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=./deploy/secrets/openai_api_key
# OPENAI_API_KEY_AWS_SECRET_ID=pro-creator/prod/openai
# OPENAI_API_KEY_AWS_SECRET_KEY=api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DRAFT=gpt-4o-mini
OPENAI_MODEL_STANDARD=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4.1
RUNWAY_VIDEO_ENABLED=false
RUNWAY_API_KEY=
# RUNWAY_API_KEY_FILE=./deploy/secrets/runway_api_key
# RUNWAY_API_KEY_AWS_SECRET_ID=pro-creator/prod/runway
# RUNWAY_API_KEY_AWS_SECRET_KEY=api_key
RUNWAY_API_BASE=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_VIDEO_MODEL_DEFAULT=gen4_turbo
RUNWAY_VIDEO_MODEL_PREMIUM=gen4.5
RUNWAY_HERO_SCENES=first,last
RUNWAY_VIDEO_DURATION_SECONDS=5
RUNWAY_POLL_TIMEOUT_SECONDS=240
RUNWAY_POLL_INTERVAL_SECONDS=4

# Optional owner-only feature gate (comma-separated emails)
OWNER_EMAIL_ALLOWLIST=

# Lip sync (required: install Rhubarb and set RHUBARB_PATH)
AUTO_LIPSYNC=true
RHUBARB_PATH=/app/deploy/bin/rhubarb
RHUBARB_TIMEOUT=30

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=15
RATE_LIMIT_HEAVY_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25

# Email receipts / notifications (SMTP)
EMAIL_FROM_NAME=Pro Creator
EMAIL_FROM_ADDRESS=admin@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

# Billing (Stripe, optional)
STRIPE_SECRET_KEY=
# STRIPE_SECRET_KEY_FILE=./deploy/secrets/stripe_secret_key
# STRIPE_SECRET_KEY_AWS_SECRET_ID=pro-creator/prod/stripe
# STRIPE_SECRET_KEY_AWS_SECRET_KEY=secret_key
STRIPE_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_SECRET_FILE=./deploy/secrets/stripe_webhook_secret
# STRIPE_WEBHOOK_SECRET_AWS_SECRET_ID=pro-creator/prod/stripe
# STRIPE_WEBHOOK_SECRET_AWS_SECRET_KEY=webhook_secret
STRIPE_PRICE_ID_MODERATE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_STUDIO=
STRIPE_SUCCESS_URL=https://app.example.com/?checkout=success
STRIPE_CANCEL_URL=https://app.example.com/?checkout=cancel

# Paystack checkout
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://app.example.com/?checkout=success&provider=paystack
PAYSTACK_CURRENCY=GHS

# Observability
OBSERVABILITY_ENABLED=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=http://localhost:3001
