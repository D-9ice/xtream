# Pro Creator Pro production environment
# Copy this file to deploy/.env.production on the server and replace every CHANGE_ME value.

# Public backend hostname used by Caddy/TLS, e.g. api.example.com
DOMAIN_NAME=api.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Frontend origin(s) allowed to call the API. Comma-separated; no localhost or wildcard in production.
ALLOWED_ORIGINS=https://your-vercel-project.vercel.app

# Runtime
ENVIRONMENT=production
STRICT_PROVIDER_VALIDATION=true
AUTH_REQUIRED=true
DEFAULT_TENANT_ID=default
TENANT_HEADER_NAME=X-Tenant-ID
FACTORY_MODE_ENABLED=false

# Authentication / owner controls
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# Set true for one controlled restart only when creating/recovering the owner account.
# After successful owner login, change back to false and restart again.
ADMIN_BOOTSTRAP_SYNC=false
ADMIN_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_DASHBOARD_PASSWORD
ADMIN_2FA_ENABLED=false
ADMIN_2FA_TOTP_SECRET=
OWNER_EMAIL_ALLOWLIST=owner@example.com

# PostgreSQL
POSTGRES_DB=procreator
POSTGRES_USER=procreator
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://procreator:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/procreator

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
ENABLE_CELERY=true

# Local S3-compatible object storage (MinIO) on the Oracle host.
# Use unique strong credentials; production validation rejects default MinIO credentials.
STORAGE_BACKEND=s3
S3_BUCKET=pro-creator-pro
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_ENDPOINT=http://minio:9000
S3_USE_SSL=false
S3_PUBLIC_URL=https://api.example.com/storage/pro-creator-pro
PROJECTS_URL_BASE=https://api.example.com/storage/pro-creator-pro

# xAI / Grok — current fixed provider stack
XAI_API_KEY=CHANGE_ME_XAI_API_KEY
# Optional secret-source alternatives supported by production Compose:
# XAI_API_KEY_FILE=/app/deploy/secrets/xai_api_key
# XAI_API_KEY_AWS_SECRET_ID=
# XAI_API_KEY_AWS_SECRET_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.20-beta-latest-non-reasoning
XAI_IMAGE_MODEL=grok-imagine-image
XAI_VIDEO_MODEL=grok-imagine-video
XAI_TTS_VOICE_ID=eve
XAI_STT_MODEL=grok-voice-transcribe-2.0
GROK_IMAGINE_TARGET_SEGMENT_SECONDS=15
GROK_IMAGINE_INITIAL_CHUNK_SECONDS=15
GROK_IMAGINE_EXTENSION_CHUNK_SECONDS=10
GROK_IMAGINE_ASPECT_RATIO=16:9
GROK_IMAGINE_RESOLUTION=720p

# FFmpeg/media processing
FFMPEG_SCENE_RENDER_TIMEOUT_SECONDS=180
FFMPEG_CONCAT_TIMEOUT_SECONDS=300
VIDEO_IMPORT_MAX_BYTES=2147483648
VIDEO_IMPORT_CONNECT_TIMEOUT_SECONDS=10
VIDEO_IMPORT_READ_TIMEOUT_SECONDS=60
VIDEO_IMPORT_MAX_REDIRECTS=5
AUTO_LIPSYNC=true
RHUBARB_PATH=
RHUBARB_TIMEOUT=30

# Rate limiting / retries
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=15
RATE_LIMIT_HEAVY_REQUESTS=30
RATE_LIMIT_ANALYTICS_REQUESTS=120
RATE_LIMIT_ANALYTICS_MAX_BODY_BYTES=8192
RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
UVICORN_WORKERS=2

# Email receipts / notifications (optional)
EMAIL_FROM_NAME=Pro Creator Pro
EMAIL_FROM_ADDRESS=admin@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

# Stripe billing (optional; leave price IDs blank when Stripe is not configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MODERATE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_STUDIO=
FACTORY_MODE_ONE_TIME_STRIPE_PRICE_ID=
FACTORY_MODE_SUBSCRIPTION_STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://your-vercel-project.vercel.app/?checkout=success
STRIPE_CANCEL_URL=https://your-vercel-project.vercel.app/?checkout=cancel

# Paystack billing (optional)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://your-vercel-project.vercel.app/?checkout=success&provider=paystack
PAYSTACK_CURRENCY=GHS


# Social publishing OAuth
# Register provider callback URLs as:
# https://your-vercel-project.vercel.app/social/oauth/callback/youtube
# https://your-vercel-project.vercel.app/social/oauth/callback/facebook
# https://your-vercel-project.vercel.app/social/oauth/callback/instagram
# https://your-vercel-project.vercel.app/social/oauth/callback/x
# https://your-vercel-project.vercel.app/social/oauth/callback/tiktok
SOCIAL_OAUTH_FRONTEND_ORIGIN=https://your-vercel-project.vercel.app
SOCIAL_OAUTH_BACKEND_ORIGIN=https://api.example.com

# YouTube / Google OAuth
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=

# Meta app used for Facebook Pages + Instagram professional accounts
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_GRAPH_VERSION=v21.0

# X OAuth 1.0a app credentials
SOCIAL_X_API_KEY=
SOCIAL_X_API_SECRET=

# TikTok Login Kit + Content Posting API
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
